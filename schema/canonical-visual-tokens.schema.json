{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schema.brandcontextprotocol.dev/canonical-visual-tokens.schema.json",
  "title": "Brand Context Protocol canonical visual token model",
  "description": "Optional authoritative visual-token records for deterministic projection under an explicit manifest canonical_model declaration.",
  "type": "object",
  "properties": {
    "schema": { "const": "bcp.canonical.visual-tokens.v1" },
    "records": {
      "type": "array",
      "items": { "$ref": "#/$defs/token" }
    }
  },
  "required": ["schema", "records"],
  "additionalProperties": false,
  "$defs": {
    "stableId": {
      "type": "string",
      "minLength": 1
    },
    "scope": {
      "type": "object",
      "properties": {
        "markets": { "type": "array", "items": { "type": "string", "pattern": "^[A-Z]{2}$" }, "uniqueItems": true },
        "locales": { "type": "array", "items": { "type": "string", "pattern": "^[A-Za-z]{2,8}(?:-[A-Za-z0-9]{1,8})*$" }, "uniqueItems": true }
      },
      "minProperties": 1,
      "additionalProperties": false
    },
    "dimension": {
      "type": "object",
      "properties": {
        "amount": { "type": "number" },
        "unit": { "enum": ["px", "rem", "em", "%", "pt", "mm", "in"] }
      },
      "required": ["amount", "unit"],
      "additionalProperties": false
    },
    "token": {
      "type": "object",
      "properties": {
        "id": { "$ref": "#/$defs/stableId" },
        "kind": { "enum": ["color", "font_family", "font_weight", "dimension", "number", "string"] },
        "value": {},
        "role": { "type": "string", "minLength": 1 },
        "description": { "oneOf": [{ "type": "string" }, { "type": "null" }] },
        "scope": { "$ref": "#/$defs/scope" },
        "source_ids": { "type": "array", "items": { "$ref": "#/$defs/stableId" }, "uniqueItems": true },
        "approval_ids": { "type": "array", "items": { "$ref": "#/$defs/stableId" }, "uniqueItems": true },
        "evidence_status": { "enum": ["brand_declared", "brand_confirmed", "observed", "inferred"] }
      },
      "required": ["id", "kind", "value", "role", "description", "source_ids", "approval_ids", "evidence_status"],
      "additionalProperties": false,
      "allOf": [
        { "if": { "properties": { "kind": { "const": "color" } }, "required": ["kind"] }, "then": { "properties": { "value": { "type": "string", "pattern": "^#[0-9A-F]{6}(?:[0-9A-F]{2})?$" } } } },
        { "if": { "properties": { "kind": { "enum": ["font_family", "string"] } }, "required": ["kind"] }, "then": { "properties": { "value": { "type": "string", "minLength": 1 } } } },
        { "if": { "properties": { "kind": { "const": "font_weight" } }, "required": ["kind"] }, "then": { "properties": { "value": { "type": "integer", "minimum": 1, "maximum": 1000 } } } },
        { "if": { "properties": { "kind": { "const": "number" } }, "required": ["kind"] }, "then": { "properties": { "value": { "type": "number" } } } },
        { "if": { "properties": { "kind": { "const": "dimension" } }, "required": ["kind"] }, "then": { "properties": { "value": { "$ref": "#/$defs/dimension" } } } }
      ]
    }
  }
}
