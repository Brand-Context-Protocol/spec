{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://brandcontextprotocol.dev/schema/2.0/delivery.schema.json",
  "title": "BCP 2.0 document delivery",
  "type": "object",
  "required": [
    "response_scope",
    "content_complete",
    "available_paths",
    "files",
    "integrity_scope",
    "integrity"
  ],
  "properties": {
    "response_scope": {
      "enum": [
        "root",
        "path",
        "full_tree"
      ]
    },
    "content_complete": {
      "type": "boolean"
    },
    "path": {
      "type": "string"
    },
    "available_paths": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^/\\.well-known/(?:brand\\.md|brand\\.json|DESIGN\\.md|brand/(?:[a-z0-9_-]+/)*[a-z0-9_-]+\\.(?:md|json))$"
      }
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "path",
          "content",
          "sha256"
        ],
        "properties": {
          "path": {
            "type": "string",
            "pattern": "^/\\.well-known/(?:brand\\.md|brand\\.json|DESIGN\\.md|brand/(?:[a-z0-9_-]+/)*[a-z0-9_-]+\\.(?:md|json))$"
          },
          "content": {
            "type": "string"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "signature": {
            "type": [
              "string",
              "null"
            ]
          },
          "kid": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "additionalProperties": true
      }
    },
    "integrity_scope": {
      "enum": [
        "publication_manifest",
        "legacy_per_file",
        "unsigned"
      ]
    },
    "integrity": {
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "revision_id": {
          "type": "string",
          "minLength": 1
        },
        "publication_id": {
          "type": "string",
          "minLength": 1
        },
        "manifest_sha256": {
          "type": "string",
          "minLength": 1
        },
        "manifest_signature": {
          "type": "string",
          "minLength": 1
        },
        "manifest_signature_kid": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "revision_id",
        "publication_id",
        "manifest_sha256",
        "manifest_signature",
        "manifest_signature_kid"
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "response_scope": {
            "const": "full_tree"
          }
        }
      },
      "then": {
        "properties": {
          "content_complete": {
            "const": true
          }
        },
        "not": {
          "required": [
            "path"
          ]
        }
      },
      "else": {
        "required": [
          "path"
        ],
        "properties": {
          "files": {
            "minItems": 1,
            "maxItems": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "response_scope": {
            "const": "root"
          }
        }
      },
      "then": {
        "properties": {
          "path": {
            "const": "/.well-known/brand.md"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "integrity_scope": {
            "const": "publication_manifest"
          }
        }
      },
      "then": {
        "properties": {
          "integrity": {
            "type": "object"
          }
        }
      },
      "else": {
        "properties": {
          "integrity": {
            "type": "null"
          }
        }
      }
    }
  ]
}
