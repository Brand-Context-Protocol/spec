{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schema.brandcontextprotocol.dev/manifest.schema.json",
  "title": "Brand Context Protocol package manifest",
  "description": "Optional manifest for a package-enriched BCP. The manifest lists core files, extension files, assets, media types, and checksums. It is not required for core BCP conformance.",
  "type": "object",
  "properties": {
    "bcp_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+$"
    },
    "tree_version": {
      "type": "string"
    },
    "brand_name": {
      "type": "string"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "last_updated": {
      "type": "string",
      "format": "date-time"
    },
    "files": {
      "type": "array",
      "items": { "$ref": "#/$defs/fileRecord" }
    },
    "extensions": {
      "type": "object",
      "additionalProperties": {
        "oneOf": [
          { "$ref": "#/$defs/packagePath" },
          {
            "type": "array",
            "items": { "$ref": "#/$defs/packagePath" }
          }
        ]
      }
    },
    "canonical_model": {
      "type": "object",
      "description": "Explicit opt-in declaration for typed canonical authority. Markdown remains authoritative when this declaration is absent or projection is manual.",
      "properties": {
        "schema": { "const": "bcp.canonical.v1" },
        "records": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/jsonPackagePath" }
        },
        "projection": { "enum": ["deterministic", "manual"] }
      },
      "required": ["schema", "records", "projection"],
      "additionalProperties": false
    },
    "renderer": {
      "type": "object",
      "description": "Receipt for immutable deterministic renderer behavior. Forbidden for manually projected canonical models.",
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "canonical_state_sha256": { "$ref": "#/$defs/sha256" },
        "projected_tree_sha256": { "$ref": "#/$defs/sha256" }
      },
      "required": ["name", "version", "canonical_state_sha256", "projected_tree_sha256"],
      "additionalProperties": false
    },
    "signature": {
      "type": "object",
      "properties": {
        "algorithm": { "type": "string" },
        "key_id": { "type": "string" },
        "value": { "type": "string" }
      },
      "additionalProperties": true
    }
  },
  "required": ["bcp_version", "tree_version", "brand_name", "files"],
  "additionalProperties": true,
  "allOf": [
    {
      "if": {
        "properties": {
          "canonical_model": {
            "type": "object",
            "properties": { "projection": { "const": "manual" } },
            "required": ["projection"]
          }
        },
        "required": ["canonical_model"]
      },
      "then": { "not": { "required": ["renderer"] } }
    }
  ],
  "$defs": {
    "fileRecord": {
      "type": "object",
      "properties": {
        "path": { "$ref": "#/$defs/packagePath" },
        "media_type": { "type": "string" },
        "role": { "type": "string" },
        "required": { "type": "boolean" },
        "byte_length": { "type": "integer", "minimum": 0 },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": ["path", "media_type", "role", "required"],
      "additionalProperties": true,
      "allOf": [
        {
          "if": {
            "properties": { "role": { "const": "revision_receipt" } },
            "required": ["role"]
          },
          "then": { "not": { "required": ["sha256"] } }
        }
      ]
    },
    "packagePath": {
      "type": "string",
      "pattern": "^/.+"
    },
    "jsonPackagePath": {
      "type": "string",
      "pattern": "^/.+\\.json$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
